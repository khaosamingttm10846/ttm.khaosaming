rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint for health checks
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles for hospital staff
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Traditional Thai Medicine clinical service records
    match /service_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Monthly income and expenditure records
    match /financial_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Pinned special clinic days and activities
    match /clinic_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
